---
import { Picture } from 'astro:assets';
import cardHandoverHands from '../images/card-handover-hands.webp';
import cupsAndBallsSmile from '../images/cups-and-balls-smile.webp';

// Photos are shown uncropped at their own aspect ratio; the two share one row height (weights = ratios)
const photos = [
	{ src: cardHandoverHands, alt: 'Hände übergeben Spielkarten bei einem Kartenkunststück' },
	{ src: cupsAndBallsSmile, alt: 'Reinhard Hütter lächelt bei einem Becherspiel am Tisch' },
];
---

<section class="section" id="stil">
	<div class="section-inner style">
		<div class="style-copy">
			<p class="eyebrow">Der Stil</p>
			<h2 class="section-title">Zauberkunst mit Humor</h2>
			<p class="style-text">
				Staunen und Lachen gehören zusammen. Genau das verbinde ich: verblüffende Zauberkunst, ganz
				nah an den Gästen, gewürzt mit pointiertem Humor. Über zehn Jahre Zauberkunst und die
				Erfahrung als Schauspieler auf der Theaterbühne sorgen dafür, dass jede Szene Timing hat und
				jede Pointe sitzt, ob direkt am Tisch oder als Salon-Show. So entstehen Momente, die den
				Gästen lange im Gedächtnis bleiben.
			</p>
		</div>

		<div class="style-stage">
			{
				photos.map(({ src, alt }) => (
					<figure class="shot" style={`--ar: ${src.width / src.height};`}>
						<Picture
							src={src}
							alt={alt}
							formats={['avif', 'webp']}
							fallbackFormat="webp"
							widths={[400, 800, 1067]}
							sizes="(min-width: 960px) 28vw, 46vw"
						/>
					</figure>
				))
			}
		</div>
	</div>
</section>

<style>
	.style {
		display: grid;
		gap: var(--space-5);
	}

	.style-copy {
		display: grid;
		gap: var(--space-3);
	}

	.style-copy .eyebrow {
		margin: 0;
	}

	.style-text {
		max-width: 40rem;
		margin: 0;
		font-size: var(--text-base);
		color: var(--color-text-muted);
	}

	/* Equal height by construction: width of each photo is proportional to its aspect ratio */
	.style-stage {
		display: flex;
		gap: var(--space-2);
		align-items: flex-start;
	}

	.shot {
		flex: var(--ar) 1 0;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
		aspect-ratio: var(--ar);
	}

	.shot :global(picture),
	.shot :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (min-width: 960px) {
		.style {
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
			gap: var(--space-7);
			align-items: center;
		}

		.style .section-title {
			margin-bottom: 0;
		}

		.style-stage {
			gap: var(--space-3);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.shot :global(img) {
			transition: transform var(--duration-slow) var(--ease-out);
		}

		.shot:hover :global(img) {
			transform: scale(1.03);
		}
	}
</style>
