---
import { Picture } from 'astro:assets';
import styleMain from '../images/standing-table-guest.webp';
import styleSide from '../images/card-handover-hands.webp';
import styleDetail from '../images/cups-and-balls-smile.webp';
---

<section class="section" id="stil">
	<div class="section-inner style">
		<div class="style-copy">
			<h2 class="section-title">Zauberkunst mit Humor</h2>
			<p class="style-text">
				Staunen und Lachen gehören zusammen. Genau das verbinde ich: verblüffende Zauberkunst, ganz
				nah an den Gästen, gewürzt mit pointiertem Humor. Über zehn Jahre Zauberkunst und die
				Erfahrung als Schauspieler auf der Theaterbühne sorgen dafür, dass jede Szene Timing hat und
				jede Pointe sitzt, ob direkt am Tisch oder als Salon-Show. So entstehen Momente, die den
				Gästen lange im Gedächtnis bleiben.
			</p>
		</div>

		<!-- Composed photo cluster: one scene, three beats — interaction, face, craft -->
		<div class="style-stage" aria-hidden="false">
			<figure class="shot shot-main">
				<Picture
					src={styleMain}
					alt="Reinhard Hütter zeigt einem Gast Close-up-Magie an einem Stehtisch"
					formats={['avif', 'webp']}
					fallbackFormat="webp"
					widths={[400, 800, 1200]}
					sizes="(min-width: 960px) 48vw, 92vw"
				/>
			</figure>
			<figure class="shot shot-side">
				<Picture
					src={styleSide}
					alt="Hände übergeben Spielkarten bei einem Kartenkunststück"
					formats={['avif', 'webp']}
					fallbackFormat="webp"
					widths={[320, 640, 960]}
					sizes="(min-width: 960px) 22vw, 42vw"
				/>
			</figure>
			<figure class="shot shot-detail">
				<Picture
					src={styleDetail}
					alt="Reinhard Hütter lächelt bei einem Becherspiel am Tisch"
					formats={['avif', 'webp']}
					fallbackFormat="webp"
					widths={[400, 800, 1200]}
					sizes="(min-width: 960px) 28vw, 70vw"
				/>
			</figure>
		</div>
	</div>
</section>

<style>
	.style {
		display: grid;
		gap: var(--space-5);
	}

	.style-copy {
		display: grid;
		gap: var(--space-3);
	}

	.style-text {
		max-width: 40rem;
		margin: 0;
		font-size: var(--text-base);
		color: var(--color-text-muted);
	}

	/* Dense photo composition — almost touching, slight overlap for stage energy */
	.style-stage {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: var(--space-2);
		align-items: stretch;
	}

	.shot {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	/* Images fill their frame absolutely, so only the main photo's ratio sets the height */
	.shot :global(picture),
	.shot :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.shot-main {
		grid-column: 1;
		grid-row: 1 / 3;
		aspect-ratio: 3 / 4;
	}

	.shot-side {
		grid-column: 2;
		grid-row: 1;
	}

	.shot-detail :global(img) {
		object-position: 50% 85%;
	}

	.shot-detail {
		grid-column: 2;
		grid-row: 2;
	}

	@media (min-width: 960px) {
		.style {
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr);
			gap: var(--space-7);
			align-items: center;
		}

		.style .section-title {
			margin-bottom: 0;
		}

		.style-stage {
			gap: var(--space-3);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.shot :global(img) {
			transition: transform var(--duration-slow) var(--ease-out);
		}

		.shot:hover :global(img) {
			transform: scale(1.03);
		}
	}
</style>
