---
import Cloche from './Cloche.astro';
import EnquiryForm from './EnquiryForm.astro';
---

<section class="section" id="kontakt">
	<div class="section-inner">
		<h2 class="section-title">Bereit für ein kleines Wunder?</h2>
		<p class="section-lead">
			Erzählen Sie mir von Ihrem Anlass. Je mehr ich weiß, desto passender wird das Programm.
		</p>

		<div class="contact-grid">
			<Cloche />
			<EnquiryForm />
		</div>
	</div>
</section>

<style>
	.contact-grid {
		display: grid;
		gap: var(--space-8);
	}

	/* Cloche left, form right on large screens */
	@media (min-width: 960px) {
		.contact-grid {
			grid-template-columns: 5fr 7fr;
			align-items: start;
			gap: var(--space-8);
		}
	}
</style>
