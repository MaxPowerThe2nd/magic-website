---
// Effect module "floating-cards": playing-card backs drifting slowly behind the hero figure.
// The drift is pure CSS; src/scripts/effects/floating-cards.ts only adds a light
// mouse parallax on devices with a fine pointer. With reduced motion the cards stand still.

// Position and size in % of the photo box, rotation in deg, depth 0..1 (1 = front),
// blur in px for depth, animation duration and delay in s
const cards = [
	{ x: 6, y: 6, w: 15, rot: -14, depth: 0.35, blur: 4, dur: 17, delay: -3, opacity: 0.25 },
	{ x: 76, y: 3, w: 13, rot: 12, depth: 0.3, blur: 5, dur: 19, delay: -9, opacity: 0.22 },
	{ x: 60, y: 20, w: 12, rot: -6, depth: 0.45, blur: 3, dur: 15, delay: -5, opacity: 0.28 },
	{ x: 80, y: 34, w: 17, rot: 18, depth: 1, blur: 0, dur: 13, delay: -1, opacity: 0.4 },
];
---

<div class="floating-cards" data-effect="floating-cards" aria-hidden="true">
	<svg class="card-defs" width="0" height="0" focusable="false">
		<defs>
			<pattern id="card-back-pattern" width="8" height="8" patternUnits="userSpaceOnUse">
				<path d="M4 0 8 4 4 8 0 4Z" fill="none" stroke="currentColor" stroke-width="0.6"></path>
			</pattern>
			<symbol id="card-back" viewBox="0 0 50 70">
				<rect x="1" y="1" width="48" height="68" rx="4" fill="none" stroke="currentColor" stroke-width="1.2"
				></rect>
				<rect x="4" y="4" width="42" height="62" rx="2.5" fill="none" stroke="currentColor" stroke-width="0.6"
				></rect>
				<rect x="6" y="6" width="38" height="58" rx="1.5" fill="url(#card-back-pattern)"></rect>
			</symbol>
		</defs>
	</svg>

	{
		cards.map((card) => (
			<div
				class="fc-card"
				style={`--x:${card.x}%;--y:${card.y}%;--w:${card.w}%;--rot:${card.rot}deg;--depth:${card.depth};--blur:${card.blur}px;--dur:${card.dur}s;--delay:${card.delay}s;--opacity:${card.opacity}`}
			>
				<svg class="fc-drift" viewBox="0 0 50 70">
					<use href="#card-back" />
				</svg>
			</div>
		))
	}
</div>

<style>
	.floating-cards {
		/* Set by the parallax script, -1..1 */
		--mx: 0;
		--my: 0;
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.card-defs {
		position: absolute;
	}

	/* Outer element: position and mouse parallax */
	.fc-card {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--w);
		color: var(--color-card-back);
		opacity: var(--opacity);
		filter: blur(var(--blur));
		transform: translate3d(
			calc(var(--mx) * var(--depth) * 18px),
			calc(var(--my) * var(--depth) * 12px),
			0
		);
		transition: transform 0.6s var(--ease-out);
	}

	/* Inner element: slow endless drift */
	.fc-drift {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		transform: rotate(var(--rot));
		animation: card-drift var(--dur) ease-in-out var(--delay) infinite alternate;
	}

	@keyframes card-drift {
		0% {
			transform: translate(0, 0) rotate(var(--rot));
		}

		50% {
			transform: translate(6%, -9%) rotate(calc(var(--rot) + 5deg));
		}

		100% {
			transform: translate(-5%, 6%) rotate(calc(var(--rot) - 4deg));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fc-drift {
			animation: none;
		}

		.fc-card {
			transition: none;
		}
	}
</style>
