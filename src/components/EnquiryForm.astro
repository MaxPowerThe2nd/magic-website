---
// Structured enquiry form. Sent to the Worker (src/worker/index.ts), protected by Cloudflare
// Turnstile and a honeypot. With JS: src/scripts/effects/enquiry-form.ts validates and sends via
// fetch. Without JS: a normal POST; the Worker redirects back to #anfrage-ok / #anfrage-fehler
// and the matching message below is shown via CSS :target.
import { contact, emailHref, formEndpoint, turnstileSiteKey } from '../data/contact';

const occasions = ['Firmenevent', 'Hochzeit', 'Privatfeier', 'Restaurant', 'Scheidung', 'Sonstiges'];
const formats = ['Tischzauberei (Close-up / Table Hopping)', 'Salon-Show', 'Noch offen, bitte beraten'];
---

<div class="enquiry" id="anfrage">
	<form
		class="form"
		action={formEndpoint}
		method="post"
		data-effect="enquiry-form"
		data-confirmation="enquiry-confirmation"
		data-status="enquiry-status"
	>
		<div class="field">
			<label for="enquiry-date">Datum</label>
			<input id="enquiry-date" name="datum" type="date" />
		</div>

		<div class="field">
			<label for="enquiry-place">Ort</label>
			<input id="enquiry-place" name="ort" type="text" autocomplete="address-level2" />
		</div>

		<div class="field">
			<label for="enquiry-occasion">Anlass</label>
			<select id="enquiry-occasion" name="anlass">
				<option value="">Bitte wählen</option>
				{occasions.map((occasion) => <option>{occasion}</option>)}
			</select>
		</div>

		<div class="field">
			<label for="enquiry-guests">Gästeanzahl</label>
			<input
				id="enquiry-guests"
				name="gaeste"
				type="number"
				min="1"
				inputmode="numeric"
				data-error-range="Bitte geben Sie mindestens einen Gast an."
			/>
			<p class="field-error" id="enquiry-guests-error" hidden></p>
		</div>

		<div class="field field-wide">
			<label for="enquiry-format">Gewünschtes Format</label>
			<select id="enquiry-format" name="format">
				<option value="">Bitte wählen</option>
				{formats.map((format) => <option>{format}</option>)}
			</select>
		</div>

		<div class="field field-wide">
			<label for="enquiry-message">Nachricht</label>
			<textarea id="enquiry-message" name="nachricht" rows="4"></textarea>
		</div>

		<div class="field">
			<label for="enquiry-name">Name <span aria-hidden="true">*</span></label>
			<input
				id="enquiry-name"
				name="name"
				type="text"
				autocomplete="name"
				required
				data-error-missing="Bitte geben Sie Ihren Namen an."
			/>
			<p class="field-error" id="enquiry-name-error" hidden></p>
		</div>

		<div class="field">
			<label for="enquiry-email">E-Mail <span aria-hidden="true">*</span></label>
			<input
				id="enquiry-email"
				name="email"
				type="email"
				autocomplete="email"
				required
				data-error-missing="Bitte geben Sie Ihre E-Mail-Adresse an."
				data-error-type="Bitte geben Sie eine gültige E-Mail-Adresse an, z. B. name@beispiel.at."
			/>
			<p class="field-error" id="enquiry-email-error" hidden></p>
		</div>

		<div class="field">
			<label for="enquiry-phone">Telefon</label>
			<input id="enquiry-phone" name="telefon" type="tel" autocomplete="tel" />
		</div>

		<!-- Honeypot: invisible for people, bots fill it in; such enquiries are discarded -->
		<div class="honeypot" aria-hidden="true">
			<label for="enquiry-website">Website</label>
			<input id="enquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" />
		</div>

		<!-- Cloudflare Turnstile: only becomes visible if an interaction is needed -->
		<div
			class="field-wide turnstile cf-turnstile"
			data-sitekey={turnstileSiteKey}
			data-language="de"
			data-theme="dark"
			data-size="flexible"
			data-appearance="interaction-only"
		>
		</div>

		<div class="field field-wide form-footer">
			<p class="required-note"><span aria-hidden="true">*</span> Pflichtfeld</p>
			<button class="button" type="submit">Anfrage senden</button>
		</div>

		<p class="field-wide privacy-note">
			Ihre Angaben verwende ich nur, um Ihre Anfrage zu beantworten. Mehr dazu in der{' '}
			<a href="/datenschutz">Datenschutzerklärung</a>.
		</p>

		<p class="field-wide form-status" id="enquiry-status" role="alert" hidden></p>
	</form>

	<p class="confirmation" id="enquiry-confirmation" role="status" tabindex="-1" hidden>
		Ihre Anfrage ist angerichtet. Die Antwort kommt innerhalb von [TODO: Zeitraum].
	</p>

	<!-- Results of a plain form POST without JavaScript, shown via :target after the redirect -->
	<p class="confirmation form-result" id="anfrage-ok" tabindex="-1">
		Ihre Anfrage ist angerichtet. Die Antwort kommt innerhalb von [TODO: Zeitraum].
	</p>
	<p class="form-status form-result" id="anfrage-fehler" tabindex="-1">
		Ihre Anfrage konnte leider nicht gesendet werden. Das Formular braucht JavaScript für die
		Sicherheitsprüfung. Schreiben Sie mir gerne direkt an{' '}
		<a href={emailHref}>{contact.email}</a>.
	</p>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
	.enquiry {
		scroll-margin-top: var(--header-height);
	}

	.form {
		position: relative;
		display: grid;
		gap: var(--space-4);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	label {
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	input,
	select,
	textarea {
		width: 100%;
		min-height: var(--tap-target);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		font: inherit;
		font-size: var(--text-base);
		color: var(--color-text);
		background: var(--bg);
		color-scheme: dark;
	}

	textarea {
		resize: vertical;
	}

	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
		border-color: var(--color-accent);
	}

	.form-footer {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}

	.field-error {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-accent);
	}

	.field-error::before {
		content: '! ';
		font-weight: 600;
	}

	input[aria-invalid='true'],
	select[aria-invalid='true'],
	textarea[aria-invalid='true'] {
		border-color: var(--color-accent);
		border-width: 2px;
	}

	.button:disabled {
		cursor: not-allowed;
		opacity: 0.6;
	}

	.privacy-note,
	.form-status {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.form-status {
		padding: var(--space-4);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		color: var(--color-text);
	}

	/* Honeypot stays out of sight and out of the layout */
	.honeypot {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	/* No empty gap while Turnstile stays invisible */
	.turnstile:empty {
		display: none;
	}

	/* Messages after a plain POST: hidden until the redirect targets them */
	.form-result {
		display: none;
		margin-top: var(--space-5);
	}

	.form-result:target {
		display: block;
		scroll-margin-top: calc(var(--header-height) + var(--space-6));
	}

	.required-note {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--color-text-faint);
	}

	.confirmation {
		margin: 0;
		padding: var(--space-6);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		font-family: var(--font-display);
		font-size: var(--text-lead);
		color: var(--color-accent);
	}

	/* Two columns on large screens */
	@media (min-width: 720px) {
		.form {
			grid-template-columns: 1fr 1fr;
			column-gap: var(--space-5);
		}

		.field-wide {
			grid-column: 1 / -1;
		}
	}
</style>
