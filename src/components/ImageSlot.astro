---
// Optional image slot: renders nothing until an image is set, so there are
// never empty boxes or broken images. To fill a slot, put the photo into
// src/images, import it in the section and pass it as `image`.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	image?: ImageMetadata;
	alt?: string;
	caption?: string;
	sizes?: string;
	class?: string;
}

const { image, alt = '', caption, sizes = '100vw', class: className } = Astro.props;
---

{
	image && (
		<figure class:list={['image-slot', className]}>
			<Picture
				src={image}
				alt={alt}
				formats={['avif', 'webp']}
				fallbackFormat="webp"
				widths={[400, 800, 1200]}
				sizes={sizes}
			/>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	)
}

<style>
	.image-slot {
		margin: 0;
	}

	.image-slot :global(img) {
		width: 100%;
		border-radius: var(--radius);
	}

	figcaption {
		margin-top: var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-lead-min);
		color: var(--color-text-muted);
	}
</style>
