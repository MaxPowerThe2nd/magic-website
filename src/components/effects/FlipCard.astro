---
// Effect module "card-flip": a playing card with a front and a back.
// Behaviour in src/scripts/effects/card-flip.ts. Without JS both sides are shown one below
// the other; with reduced motion the sides cross-fade instead of turning in 3D.
// Usage: <FlipCard id="..." openLabel="..."><Fragment slot="front">…</Fragment><Fragment slot="back">…</Fragment></FlipCard>
interface Props {
	id: string;
	/** Text of the button on the front that turns the card */
	openLabel?: string;
	/** Text of the button on the back that turns the card back */
	closeLabel?: string;
}

const { id, openLabel = 'Details ansehen', closeLabel = 'Zurück' } = Astro.props;
---

<div class="flip" data-effect="card-flip">
	<div class="flip-inner">
		<div class="flip-face flip-front" data-flip-front>
			<slot name="front" />
			<button class="flip-button flip-open" type="button" aria-expanded="false" aria-controls={`${id}-back`}>
				{openLabel} <span aria-hidden="true">↻</span>
			</button>
		</div>

		<div class="flip-face flip-back" id={`${id}-back`} data-flip-back>
			<div class="flip-back-content">
				<slot name="back" />
				<button class="flip-button flip-close" type="button">
					<span aria-hidden="true">↺</span>
					{closeLabel}
				</button>
			</div>
		</div>
	</div>
</div>

<style>
	.flip {
		width: 100%;
		max-width: 360px;
		margin-inline: auto;
		perspective: 1400px;
	}

	/* Without JS: both sides one below the other */
	.flip-inner {
		display: grid;
		gap: var(--space-4);
		/* Cards in the same row get the same height */
		height: 100%;
	}

	.flip-face {
		display: flex;
		flex-direction: column;
		/* Playing card proportions and rounded corners. The explicit width keeps long back-side
		   text from widening the card through the aspect ratio; the card grows in height instead. */
		width: 100%;
		min-width: 0;
		aspect-ratio: 5 / 7;
		border-radius: var(--radius);
		box-shadow: var(--shadow-card);
	}

	/* Front: cream card paper with navy print */
	.flip-front {
		position: relative;
		padding: var(--space-5);
		background: var(--color-text);
		color: var(--color-navy);
	}

	/* Back: calm surface, the card-back pattern only as a subtle frame */
	.flip-back {
		padding: var(--space-3);
		background:
			repeating-linear-gradient(45deg, var(--color-border) 0 1px, transparent 1px 9px),
			repeating-linear-gradient(-45deg, var(--color-border) 0 1px, transparent 1px 9px), var(--bg);
		color: var(--color-text);
	}

	.flip-back-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: var(--space-5);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
	}

	.flip-button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		align-self: flex-start;
		min-height: var(--tap-target);
		margin-top: auto;
		padding: 0;
		border: none;
		background: none;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: var(--tracking-button);
		text-transform: uppercase;
		color: inherit;
		cursor: pointer;
	}

	/* The open button covers the whole front, so a tap anywhere turns the card */
	.flip-open::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius);
	}

	.flip-open:focus-visible {
		outline: none;
	}

	.flip-open:focus-visible::after {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	/* Buttons only make sense when the card can turn */
	.flip:not(.is-ready) .flip-button {
		display: none;
	}

	/* ---- With JS: both faces share one grid cell, only one is visible ---- */
	.flip.is-ready .flip-inner {
		gap: 0;
	}

	.flip.is-ready .flip-face {
		grid-area: 1 / 1;
		backface-visibility: hidden;
		transition:
			transform var(--duration-slow) var(--ease-out),
			opacity var(--duration-slow) var(--ease-out);
	}

	.flip.is-ready .flip-back {
		transform: rotateY(180deg);
	}

	.flip.is-ready.is-flipped .flip-front {
		transform: rotateY(-180deg);
	}

	.flip.is-ready.is-flipped .flip-back {
		transform: rotateY(0deg);
	}

	/* Reduced motion: simple cross-fade instead of a 3D turn */
	@media (prefers-reduced-motion: reduce) {
		.flip.is-ready .flip-face,
		.flip.is-ready .flip-back,
		.flip.is-ready.is-flipped .flip-front {
			transform: none;
		}

		.flip.is-ready .flip-back,
		.flip.is-ready.is-flipped .flip-front {
			opacity: 0;
			visibility: hidden;
		}

		.flip.is-ready.is-flipped .flip-back {
			opacity: 1;
			visibility: visible;
		}

		.flip.is-ready .flip-face {
			transition:
				opacity var(--duration-base),
				visibility var(--duration-base);
		}
	}
</style>
