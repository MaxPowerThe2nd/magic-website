---
// Burning playing card, rendered in a <canvas> by src/scripts/effects/burning-card.js:
// shortly after the page has loaded the intact ace catches fire at its top right corner,
// burns away a frayed corner (slowly at first, then ever faster) and keeps burning lightly.
// Restarts on every load. The flames are drawn procedurally in the canvas, anchored on the
// burn edge, so no video and no mix-blend-mode are needed and the card may float.
//
// Without JS the intact card is shown as a normal image. The canvas is larger than the
// card (extra room above and to the right) to leave space for the flames.
// Assets: /public/effects/burning-card/
const base = '/effects/burning-card';
---

<div class="burning-card" data-effect="burning-card" aria-hidden="true">
	<img
		class="burning-card__fallback"
		src={`${base}/card-intact.webp`}
		width="150"
		height="210"
		alt=""
		decoding="async"
	/>
	<canvas class="burning-card__canvas"></canvas>
</div>

<style>
	.burning-card {
		/* Width of the card itself; the canvas around it is larger */
		--burning-card-width: 150px;
		position: absolute;
		width: var(--burning-card-width);
		aspect-ratio: 150 / 210;
		pointer-events: none;
		animation: burning-card-float 17s ease-in-out -4s infinite alternate;
	}

	/* Without JS: the intact card, tilted like the canvas version */
	.burning-card__fallback {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		transform: rotate(-12deg);
	}

	/* Canvas: 20% extra on the left, 60% on the right, 80% above and 15% below the card box.
	   The script mirrors these values (CANVAS_MARGIN). */
	.burning-card__canvas {
		position: absolute;
		left: -20%;
		top: -80%;
		width: 180%;
		height: 195%;
		display: none;
	}

	.burning-card.is-ready .burning-card__canvas {
		display: block;
	}

	.burning-card.is-ready .burning-card__fallback {
		display: none;
	}


	/* Gentle drift, like the floating card backs */
	@keyframes burning-card-float {
		0% {
			transform: translate(0, 0) rotate(0deg);
		}

		50% {
			transform: translate(3%, -3%) rotate(1.5deg);
		}

		100% {
			transform: translate(-2%, 2%) rotate(-1deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.burning-card {
			animation: none;
		}
	}
</style>
