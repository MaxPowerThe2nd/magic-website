---
// Links point to the one-pager sections (in the order given in AGENTS.md)
const links = [
	{ href: '/#shows', label: 'Shows' },
	{ href: '/#fotos', label: 'Fotos & Videos' },
	{ href: '/#stimmen', label: 'Stimmen' },
	{ href: '/#ueber-mich', label: 'Über mich' },
	{ href: '/#faq', label: 'FAQ' },
	{ href: '/#kontakt', label: 'Kontakt' },
];
---

<header class="navbar" data-navbar>
	<div class="navbar-inner container">
		<a class="brand" href="/">
			<span class="brand-name">Reinhard Hütter</span>
			<span class="brand-role">Zauberkünstler</span>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="main-menu"
			data-menu-toggle
		>
			<span class="visually-hidden">Menü</span>
			<span class="menu-icon" aria-hidden="true"></span>
		</button>

		<nav id="main-menu" class="menu" aria-label="Hauptmenü" data-menu>
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	if (navbar && toggle && menu) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			navbar.classList.toggle('is-open', open);
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		// Close the mobile menu after choosing a section or pressing Escape
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		// Mark the menu item of the section currently in view as active
		const links = [...menu.querySelectorAll<HTMLAnchorElement>('a[href*="#"]')];
		const sections = links
			.map((link) => document.getElementById(link.hash.slice(1)))
			.filter((section): section is HTMLElement => Boolean(section));
		const spy = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					for (const link of links) {
						if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
						else link.removeAttribute('aria-current');
					}
				}
			},
			{ rootMargin: '-45% 0px -50% 0px' },
		);
		sections.forEach((section) => spy.observe(section));
	}
</script>

<style>
	/* Opaque light header, so scrolled content never shows behind logo and nav */
	.navbar {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		color: var(--color-header-text);
		background: var(--color-header-bg);
	}

	/* Focus ring in navy, the light accent would vanish on the light header */
	.navbar :focus-visible {
		outline-color: var(--color-header-text);
	}

	.navbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: var(--header-height);
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		text-decoration: none;
	}

	.brand-name {
		font-family: var(--font-display);
		font-size: var(--text-lead-min);
		font-weight: var(--weight-display);
		line-height: 1;
	}

	.brand-role {
		font-family: var(--font-body);
		font-size: 0.625rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: var(--tracking-logo);
		text-transform: uppercase;
	}

	.brand {
		color: inherit;
	}

	/* Hamburger button with a full tap target */
	.menu-toggle {
		display: none;
		place-items: center;
		width: var(--tap-target);
		height: var(--tap-target);
		/* Line the icon up with the right gutter although the tap target is wider */
		margin-right: calc((var(--tap-target) - 22px) / -2);
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		display: block;
		width: 22px;
		height: 1.5px;
		background: currentColor;
		transition:
			transform var(--duration-base),
			opacity var(--duration-base);
	}

	.menu-icon {
		position: relative;
	}

	.menu-icon::before,
	.menu-icon::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.menu-icon::before {
		top: -7px;
	}

	.menu-icon::after {
		top: 7px;
	}

	/* Hamburger turns into an X when open */
	.is-open .menu-icon {
		background: transparent;
	}

	.is-open .menu-icon::before {
		transform: translateY(7px) rotate(45deg);
	}

	.is-open .menu-icon::after {
		transform: translateY(-7px) rotate(-45deg);
	}

	.menu ul {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.menu a {
		display: flex;
		align-items: center;
		min-height: var(--tap-target);
		padding: 0 var(--space-3);
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		color: inherit;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35em;
		transition: text-decoration-color var(--duration-fast);
	}

	/* Hover and active item: fine navy underline */
	.menu a:hover,
	.menu a:focus-visible,
	.menu a[aria-current] {
		color: inherit;
		text-decoration-color: currentColor;
	}

	/* Mobile with JS: menu collapses behind the hamburger (without JS the links stay visible) */
	@media (max-width: 959px) {
		:global(.js) .menu-toggle {
			display: grid;
		}

		:global(.js) .menu {
			display: none;
			position: absolute;
			inset: 100% 0 auto;
			background: var(--color-header-bg);
		}

		:global(.js) .is-open .menu {
			display: block;
		}

		:global(.js) .menu ul {
			flex-direction: column;
			padding: var(--space-2) 0 var(--space-4);
		}

		:global(.js) .menu a {
			padding: 0 var(--gutter);
			font-size: var(--text-base);
		}

		/* Without JS the header scrolls away instead of covering the wrapped links */
		:global(html:not(.js)) .navbar {
			position: static;
		}
	}

	/* Desktop: last link ends exactly at the right gutter */
	@media (min-width: 960px) {
		.menu li:last-child a {
			padding-right: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu a,
		.menu-icon,
		.menu-icon::before,
		.menu-icon::after {
			transition: none;
		}
	}
</style>
