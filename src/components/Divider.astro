---
// Small ornament that sits on the seam between two sections: four card suits in a hairline pill.
// Purely decorative, hidden from assistive technology, no animation.
---

<div class="divider" aria-hidden="true">
	<span>♠&#xFE0E; ♥&#xFE0E; ♦&#xFE0E; ♣&#xFE0E;</span>
</div>

<style>
	/* Zero height, so it never changes the spacing between sections */
	.divider {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		height: 0;
	}

	.divider span {
		transform: translateY(-50%);
		padding: var(--space-1) var(--space-4) var(--space-1) calc(var(--space-4) + 0.5em);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-navy);
		font-size: var(--text-sm);
		letter-spacing: 0.5em;
		color: var(--color-accent);
	}
</style>
