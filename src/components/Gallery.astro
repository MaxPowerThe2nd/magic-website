---
import { Picture } from 'astro:assets';
import cardsStageChild from '../images/cards-stage-child.webp';
import ropeMagicStage from '../images/rope-magic-stage.webp';

const photos = [
	{
		src: cardsStageChild,
		alt: 'Reinhard Hütter zeigt einem jungen Zuschauer auf der Bühne ein Kartenkunststück',
		caption: 'Hautnah: Das Wunder passiert in den Händen der Zuschauer.',
	},
	{
		src: ropeMagicStage,
		alt: 'Reinhard Hütter bei einer Seilnummer vor rot und blau beleuchtetem Bühnenvorhang',
		caption: 'Ein Seil, zwei Enden – oder doch nicht?',
	},
];
---

<section class="section section-alt" id="fotos">
	<div class="section-inner">
		<p class="eyebrow">Fotos &amp; Videos</p>
		<h2 class="section-title">Magie in Aktion</h2>

		<div class="gallery">
			{
				photos.map(({ src, alt, caption }) => (
					<figure class="tile">
						<Picture
							src={src}
							alt={alt}
							formats={['avif', 'webp']}
							fallbackFormat="webp"
							widths={[400, 800, 1200]}
							sizes="(min-width: 960px) 360px, (min-width: 720px) 50vw, 100vw"
						/>
						<figcaption>{caption}</figcaption>
					</figure>
				))
			}

			<!-- Placeholder until a showreel video exists -->
			<figure class="tile video-placeholder">
				<div class="video-frame">
					<span class="play" aria-hidden="true">▶</span>
					<span class="placeholder-note">Video folgt</span>
				</div>
				<figcaption>Showreel – demnächst hier.</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	.gallery {
		display: grid;
		gap: 1.5rem;
	}

	.tile {
		margin: 0;
	}

	.tile :global(img),
	.video-frame {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
	}

	figcaption {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-text-muted);
	}

	.video-frame {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		border: 1px dashed var(--color-border-strong);
		background: var(--color-bg);
	}

	.play {
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		padding-left: 0.25rem;
		border: 2px solid var(--color-accent);
		border-radius: 50%;
		font-size: 1.5rem;
		color: var(--color-accent);
	}

	@media (min-width: 720px) {
		.gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 960px) {
		.gallery {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
