---
import { Picture } from 'astro:assets';
import drawingRevealPointing from '../images/drawing-reveal-pointing.webp';
import tableHoppingAudience from '../images/table-hopping-audience.webp';
import standingTableGuest from '../images/standing-table-guest.webp';
import cardHandoverHands from '../images/card-handover-hands.webp';
import magicianConcentrating from '../images/magician-concentrating.webp';
import magicianSmilingStanding from '../images/magician-smiling-standing.webp';
import ropeGirlLaughing from '../images/rope-girl-laughing.webp';
import ropeBoyLaughing from '../images/rope-boy-laughing.webp';
import dollarSignGuest from '../images/dollar-sign-guest.webp';
import scarfTrickGuests from '../images/scarf-trick-guests.webp';
import cupsAndBallsSmile from '../images/cups-and-balls-smile.webp';
import cardRedCircle from '../images/card-red-circle.webp';

// Justified rows: every row spreads its photos over the full width at one common height.
// Each tile's flex weight equals its aspect ratio, so heights match exactly and no gaps can appear.
// `land` = landscape (3:2), `port` = portrait (2:3). Row mix: 2 landscape, 4 portrait, 2 x (landscape, portrait, landscape).
const L = 'land';
const P = 'port';
const rows = [
	[
		{ src: drawingRevealPointing, alt: 'Reinhard Hütter zeigt einem Gast eine Zeichnung mit rotem Kreis', kind: L },
		{ src: tableHoppingAudience, alt: 'Reinhard Hütter beim Table Hopping, Gäste schauen gespannt zu', kind: L },
	],
	[
		{ src: standingTableGuest, alt: 'Reinhard Hütter zeigt einem Gast am Stehtisch einen Kartenkunststück', kind: P },
		{ src: cardHandoverHands, alt: 'Hände übergeben Spielkarten bei einem Kartenkunststück', kind: P },
		{ src: magicianConcentrating, alt: 'Reinhard Hütter konzentriert bei einem Kunststück', kind: P },
		{ src: magicianSmilingStanding, alt: 'Reinhard Hütter lächelnd am Stehtisch', kind: P },
	],
	[
		{ src: ropeGirlLaughing, alt: 'Ein Mädchen lacht bei einer Seilnummer, im Hintergrund staunende Gäste', kind: L },
		{ src: cupsAndBallsSmile, alt: 'Reinhard Hütter lächelt bei einem Becherspiel am Tisch', kind: P },
		{ src: ropeBoyLaughing, alt: 'Ein Junge lacht begeistert bei einer Seilnummer', kind: L },
	],
	[
		{ src: dollarSignGuest, alt: 'Reinhard Hütter mit einem Gast und einem Dollarzeichen', kind: L },
		{ src: cardRedCircle, alt: 'Reinhard Hütter zeigt eine Karte mit rotem Kreis', kind: P },
		{ src: scarfTrickGuests, alt: 'Reinhard Hütter mit Tuch und zwei Gästen', kind: L },
	],
];
---

<section class="section gallery-section" id="fotos">
	<div class="section-inner">
		<header class="gallery-intro">
			<p class="eyebrow">Momente</p>
			<h2 class="section-title">Nah dran. Echt. Unvergesslich.</h2>
		</header>

		<div class="photo-mosaic" role="list" aria-label="Fotos vom Auftritt">
			{
				rows.map((row) => (
					<div class="mosaic-row" role="presentation">
						{row.map(({ src, alt, kind }) => (
							<figure class={`tile tile-${kind}`} role="listitem">
								<Picture
									src={src}
									alt={alt}
									formats={['avif', 'webp']}
									fallbackFormat="webp"
									widths={[400, 800, 1200]}
									sizes={kind === 'land' ? '(min-width: 720px) 40vw, 92vw' : '(min-width: 720px) 22vw, 46vw'}
								/>
							</figure>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.gallery-intro {
		margin-bottom: var(--space-5);
		max-width: 28rem;
	}

	.gallery-intro .section-title {
		margin: 0;
	}

	/* Mobile: two-column grid, landscape photos span both columns, portrait photos pair up */
	.photo-mosaic {
		--seam: var(--space-2);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-flow: dense;
		gap: var(--seam);
	}

	.mosaic-row {
		display: contents;
	}

	.tile {
		position: relative;
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-sm);
		background: var(--color-surface);
	}

	.tile-land {
		grid-column: span 2;
		aspect-ratio: 3 / 2;
		--weight: 1.5;
	}

	.tile-port {
		aspect-ratio: 2 / 3;
		--weight: 0.6667;
	}

	.tile :global(picture),
	.tile :global(img) {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* hairline frame and soft navy vignette tie the photos into the page colours */
	.tile::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px var(--color-border);
		background: linear-gradient(to top, rgb(11 20 38 / 0.3), transparent 40%);
		pointer-events: none;
	}

	/* Tablet and desktop: rows of equal height, widths proportional to aspect ratio */
	@media (min-width: 720px) {
		.photo-mosaic {
			display: flex;
			flex-direction: column;
		}

		.mosaic-row {
			display: flex;
			gap: var(--seam);
			align-items: flex-start;
		}

		.tile {
			flex: var(--weight) 1 0;
			min-width: 0;
		}

		.tile-land,
		.tile-port {
			grid-column: auto;
		}
	}

	@media (min-width: 960px) {
		.gallery-intro {
			margin-bottom: var(--space-6);
		}

		.photo-mosaic {
			--seam: var(--space-3);
		}

		.tile {
			border-radius: var(--radius);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.tile :global(img) {
			transition: transform var(--duration-slow) var(--ease-out);
		}

		.tile:hover :global(img) {
			transform: scale(1.04);
		}
	}
</style>
