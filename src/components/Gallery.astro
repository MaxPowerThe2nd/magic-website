---
import { Picture } from 'astro:assets';
import cardsStageChild from '../images/cards-stage-child.webp';
import ropeMagicStage from '../images/rope-magic-stage.webp';

// Photos from src/images; add more entries here to fill the slider.
// No visible text: the photos speak for themselves. The alt text stays for screen readers.
const photos = [
	{
		src: cardsStageChild,
		alt: 'Reinhard Hütter zeigt einem jungen Zuschauer auf der Bühne ein Kartenkunststück',
	},
	{
		src: ropeMagicStage,
		alt: 'Reinhard Hütter bei einer Seilnummer vor rot und blau beleuchtetem Bühnenvorhang',
	},
];
---

<section class="section" id="fotos">
	<div class="section-inner">
		<!-- Heading only for screen readers and the page outline -->
		<h2 class="visually-hidden">Fotos &amp; Videos</h2>

		<!-- Effect module "slider": a horizontal row with scroll snapping. Touch devices swipe,
		     devices with a mouse get arrow buttons (JS). Without JS the row simply scrolls sideways. -->
		<div class="slider" data-effect="slider">
			<ul class="slider-track" id="photo-slider" tabindex="0" aria-label="Fotos">
				{
					photos.map(({ src, alt }) => (
						<li class="slide">
							<Picture
								src={src}
								alt={alt}
								formats={['avif', 'webp']}
								fallbackFormat="webp"
								widths={[400, 800, 1200]}
								sizes="(min-width: 960px) 760px, 78vw"
							/>
						</li>
					))
				}
			</ul>

			<div class="slider-controls">
				<button class="slider-button" type="button" aria-controls="photo-slider" data-slider-prev>
					<span aria-hidden="true">←</span>
					<span class="visually-hidden">Vorheriges Foto</span>
				</button>
				<button class="slider-button" type="button" aria-controls="photo-slider" data-slider-next>
					<span aria-hidden="true">→</span>
					<span class="visually-hidden">Nächstes Foto</span>
				</button>
			</div>
		</div>
	</div>
</section>

<style>
	.slider {
		/* Height of the photos; their width follows each photo's own proportions */
		--slide-height: clamp(20rem, 60vh, 26rem);
	}

	.slider-track {
		display: flex;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.slider-track::-webkit-scrollbar {
		display: none;
	}

	.slider-track:focus-visible {
		outline-offset: 4px;
	}

	.slide {
		flex: none;
		scroll-snap-align: start;
		/* One swipe moves exactly one photo */
		scroll-snap-stop: always;
	}

	.slide :global(img) {
		width: auto;
		height: var(--slide-height);
		/* Wide photos never take more than most of the screen, so the next one peeks in */
		max-width: 78vw;
		object-fit: cover;
		border-radius: var(--radius);
	}

	/* Arrow buttons only with JS */
	.slider-controls {
		display: none;
		justify-content: flex-end;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.slider:global(.is-ready) .slider-controls {
		display: flex;
	}

	/* Touch devices: just swipe left and right, no arrow buttons */
	@media (hover: none) and (pointer: coarse) {
		.slider:global(.is-ready) .slider-controls {
			display: none;
		}
	}

	.slider-button {
		display: grid;
		place-items: center;
		width: var(--tap-target);
		height: var(--tap-target);
		padding: 0;
		border: 1px solid var(--color-border-strong);
		border-radius: 50%;
		font-size: var(--text-lead);
		line-height: 1;
		color: var(--color-accent);
		background: none;
		cursor: pointer;
		transition:
			border-color var(--duration-fast),
			opacity var(--duration-fast);
	}

	.slider-button:hover,
	.slider-button:focus-visible {
		border-color: var(--color-accent);
	}

	.slider-button:disabled {
		opacity: 0.35;
		cursor: default;
	}

	@media (min-width: 720px) {
		.slider {
			--slide-height: clamp(24rem, 62vh, 35rem);
		}

		.slide :global(img) {
			max-width: 70vw;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.slider-button {
			transition: none;
		}
	}
</style>
