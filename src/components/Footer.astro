---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer-inner">
		<p class="footer-name">Reinhard Hütter</p>
		<p class="footer-tagline">Magie auf dem silbernen Tablett</p>
		<nav aria-label="Rechtliches">
			<a href="/impressum">Impressum</a>
			<a href="/datenschutz">Datenschutz</a>
		</nav>
		<p class="copyright">© {year} Reinhard Hütter</p>
	</div>
</footer>

<style>
	.footer {
		/* Extra space at the bottom so the mobile booking bar never covers content */
		padding: 3rem var(--gutter) 6.5rem;
		border-top: 1px solid var(--color-border);
		text-align: center;
	}

	.footer-inner {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.footer-name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.footer-tagline {
		margin: 0.25rem 0 1.5rem;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-text-muted);
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 1rem;
	}

	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.5rem;
		font-size: var(--text-sm);
		color: var(--color-text);
	}

	.copyright {
		margin: 1rem 0 0;
		font-size: var(--text-sm);
		color: var(--color-text-faint);
	}

	@media (min-width: 960px) {
		.footer {
			padding-bottom: 3rem;
		}
	}
</style>
