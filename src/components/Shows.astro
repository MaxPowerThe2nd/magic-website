---
const occasions = [
	{
		suit: '♠',
		title: 'Firmenevents',
		wink: 'Endlich staunt das Team – und zwar nicht über die Quartalszahlen.',
		details:
			'Close-up-Magie beim Empfang, eine Show nach dem Dinner oder Table Hopping zwischen den Gängen. Lockert auf, verbindet und bleibt Gesprächsthema bis zum nächsten Meeting.',
	},
	{
		suit: '♥',
		title: 'Hochzeiten',
		wink: 'Das Ja-Wort ist das Einzige, das heute garantiert nicht verschwindet.',
		details:
			'Staunen beim Sektempfang, Unterhaltung während Fotoshooting und Wartezeiten und auf Wunsch ein ganz persönlicher magischer Moment für das Brautpaar.',
	},
	{
		suit: '♦',
		title: 'Privatfeiern',
		wink: 'Geburtstag, Jubiläum, Taufe: Der Gesprächsstoff für den Abend ist gesichert.',
		details:
			'Zauberei hautnah am Tisch oder als kleine Show im Salonstil – für Gäste von 8 bis 88, im Wohnzimmer genauso wie im Festsaal.',
	},
	{
		suit: '♣',
		title: 'Restaurants',
		wink: 'Die Wartezeit auf die Hauptspeise wird zur Hauptattraktion.',
		details:
			'Table Hopping von Tisch zu Tisch: Ihre Gäste erleben Magie direkt am Platz, ganz ohne Bühne – ein Abend, von dem man erzählt und für den man wiederkommt.',
	},
	{
		suit: '★',
		title: 'Scheidungen',
		wink: 'Ich kann vieles verschwinden lassen. Den Ex leider nicht.',
		details:
			'Ja, wirklich. Ein Abend mit Freunden, Lachen und Staunen – für einen Neuanfang mit Stil und guter Laune.',
	},
];

const formats = ['Close-up-Magie', 'Table Hopping', 'Show im Salonstil'];
---

<section class="section" id="shows">
	<div class="section-inner">
		<p class="eyebrow">Shows &amp; Anlässe</p>
		<h2 class="section-title">Für jeden Anlass die passende Magie</h2>

		<ul class="formats" aria-label="Show-Formate">
			{formats.map((format) => <li>{format}</li>)}
		</ul>

		<ul class="cards">
			{
				occasions.map(({ suit, title, wink, details }) => (
					<li>
						<button class="card" type="button" aria-pressed="false" data-flip-card>
							<span class="card-face card-front">
								<span class="card-suit" aria-hidden="true">
									{suit}
								</span>
								<span class="card-title">{title}</span>
								<span class="card-wink">„{wink}“</span>
								<span class="card-hint" aria-hidden="true">
									Umdrehen ↻
								</span>
							</span>
							<span class="card-face card-back">
								<span class="card-title card-title-small">{title}</span>
								<span class="card-details">{details}</span>
							</span>
						</button>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-flip-card]').forEach((card) => {
		card.addEventListener('click', () => {
			const flipped = card.getAttribute('aria-pressed') === 'true';
			card.setAttribute('aria-pressed', String(!flipped));
		});
	});
</script>

<style>
	.formats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 2.5rem;
		padding: 0;
		list-style: none;
	}

	.formats li {
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		font-size: var(--text-sm);
		color: var(--color-accent);
	}

	.cards {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Playing-card style flip card */
	/* Both faces share one grid cell, so the card grows to fit the longer side */
	.card {
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 17rem;
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		perspective: 1200px;
	}

	.card-face {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		backface-visibility: hidden;
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.card-front {
		background:
			radial-gradient(circle at 85% 15%, var(--color-border), transparent 40%),
			var(--color-surface);
	}

	.card-back {
		justify-content: center;
		background: var(--color-text);
		color: var(--color-bg);
		transform: rotateY(180deg);
	}

	.card[aria-pressed='true'] .card-front {
		transform: rotateY(-180deg);
	}

	.card[aria-pressed='true'] .card-back {
		transform: rotateY(0deg);
	}

	.card:focus-visible {
		outline: none;
	}

	.card:focus-visible .card-face {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.card-suit {
		font-size: 2rem;
		line-height: 1;
		color: var(--color-accent);
	}

	.card-title {
		margin-top: 1rem;
		font-family: var(--font-display);
		font-size: var(--text-h3);
		font-weight: 600;
		line-height: 1.15;
	}

	.card-title-small {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}

	.card-wink {
		margin-top: 0.75rem;
		font-family: var(--font-display);
		font-style: italic;
		line-height: 1.4;
		color: var(--color-text-muted);
	}

	.card-hint {
		margin-top: auto;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.card-details {
		line-height: 1.55;
	}

	@media (min-width: 720px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1080px) {
		.cards {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Without motion the card simply swaps sides */
	@media (prefers-reduced-motion: reduce) {
		.card-face {
			transition: none;
		}
	}
</style>
