---
import { Picture } from 'astro:assets';
import FlipCard from './effects/FlipCard.astro';
import standingTableGuest from '../images/standing-table-guest.webp';
import magicianSmilingStanding from '../images/magician-smiling-standing.webp';

// Only facts that are known are shown; rows without content are left out instead of using placeholders.
const formats = [
	{
		id: 'format-table',
		suit: '♠',
		title: 'Tischzauberei',
		subtitle: 'Close-up / Table Hopping',
		photo: standingTableGuest,
		alt: 'Reinhard Hütter zeigt einem Gast am Stehtisch einen Kartenkunststück',
		details: [
			['Ablauf', 'Ich gehe von Tisch zu Tisch und zeige Zauberkunst direkt in den Händen Ihrer Gäste.'],
			['Platzbedarf', 'Keine Bühne nötig, ich komme zu Ihren Gästen.'],
			['Passender Moment', 'Beim Empfang und als Dinner Magic – ideal zwischen den Gängen.'],
		],
	},
	{
		id: 'format-salon',
		suit: '♥',
		title: 'Salon-Show',
		subtitle: 'Show für die ganze Gruppe',
		photo: magicianSmilingStanding,
		alt: 'Reinhard Hütter lächelnd vor seinem Publikum',
		details: [
			['Ablauf', 'Eine Show für die ganze Gruppe, bequem im Sitzen.'],
			['Platzbedarf', 'Keine Bühne nötig.'],
		],
	},
];
---

<section class="section" id="formate">
	<div class="section-inner">
		<p class="eyebrow">Formate</p>
		<h2 class="section-title">Zwei Formate, ein Ziel: Staunen</h2>

		<div class="formats">
			{
				formats.map((format) => (
					<FlipCard id={format.id}>
						<Fragment slot="front">
							<figure class="card-photo" style={`--ar: ${format.photo.width / format.photo.height};`}>
								<Picture
									src={format.photo}
									alt={format.alt}
									formats={['avif', 'webp']}
									fallbackFormat="webp"
									widths={[400, 800]}
									sizes="(min-width: 720px) 336px, 92vw"
								/>
							</figure>
							<div class="front-body">
								<h3 class="card-title">{format.title}</h3>
								<p class="card-subtitle">{format.subtitle}</p>
							</div>
							<span class="index index-bottom" aria-hidden="true">
								{format.suit}
							</span>
						</Fragment>
						<Fragment slot="back">
								<span class="back-suit" aria-hidden="true">
									{format.suit}
								</span>
								<h3 class="back-title">{format.title}</h3>
								<dl class="details">
									{format.details.map(([term, text]) => (
										<div>
											<dt>{term}</dt>
											<dd>{text}</dd>
										</div>
									))}
								</dl>
							</Fragment>
					</FlipCard>
				))
			}
		</div>
	</div>
</section>

<style>
	.formats {
		display: grid;
		/* Column never grows beyond the available width because of long back-side text */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-7);
	}

	@media (min-width: 720px) {
		.formats {
			grid-template-columns: repeat(2, minmax(0, 360px));
			justify-content: center;
		}
	}

	/* Corner indices like on a real playing card */
	.index {
		position: absolute;
		font-family: var(--font-display);
		font-size: var(--text-h3);
		line-height: 1;
	}

	.index-bottom {
		right: var(--space-4);
		bottom: var(--space-4);
		transform: rotate(180deg);
	}

	/* The photo is shown whole at its own aspect ratio, like a print on card paper */
	.card-photo {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-sm);
		aspect-ratio: var(--ar);
		background: var(--color-surface);
	}

	.card-photo :global(picture),
	.card-photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.front-body {
		padding: var(--space-4) 0 0;
	}

	.card-title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-h2);
		color: inherit;
	}

	.card-subtitle {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
	}

	/* Back side: centred like a card face, text spread over the full height */
	.back-suit {
		display: block;
		text-align: center;
		font-family: var(--font-display);
		font-size: 2.5rem;
		line-height: 1;
		color: var(--color-accent);
	}

	.back-title {
		margin: var(--space-2) 0 var(--space-5);
		text-align: center;
		font-size: var(--text-h2);
	}

	.details {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-evenly;
		gap: var(--space-5);
		margin: 0 0 var(--space-4);
		text-align: center;
	}

	.details > div {
		display: grid;
		justify-items: center;
		gap: var(--space-2);
	}

	.details > div + div {
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
		align-self: stretch;
	}

	dt {
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lead);
		line-height: 1.4;
		color: var(--color-text);
	}
</style>
