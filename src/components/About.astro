---
import { Picture } from 'astro:assets';
import aboutImage from '../images/magician-concentrating.webp';
import aboutAccent from '../images/card-red-circle.webp';
---

<section class="section" id="ueber-mich">
	<div class="section-inner about">
		<div class="about-copy">
			<h2 class="section-title">Hinter dem Vorhang</h2>

			<div class="about-text">
				<p class="about-lead">
					Seien Sie gegrüßt! Ich bin Reinhard Hütter – Zauberkünstler, Entertainer und
					leidenschaftlicher Geschichtenerzähler.
				</p>
				<p>
					Seit 10 Jahren verbinde ich Magie mit Schauspiel: Jede Szene ist durchdacht, jeder Moment
					hat Timing – und trotzdem bleibt Platz für das Unerwartete. Das Ergebnis ist Unterhaltung,
					die erstaunt und zum Lachen bringt.
				</p>
				<p>
					Am liebsten bin ich ganz nah dran: Close-up-Magie direkt vor Ihren Augen, Table Hopping
					von Tisch zu Tisch oder eine Show im Salonstil für kleinere und mittlere Gesellschaften.
				</p>
				<p class="signature">Reinhard Hütter</p>
			</div>
		</div>

		<div class="about-stage">
			<figure class="about-portrait">
				<Picture
					src={aboutImage}
					alt="Reinhard Hütter konzentriert bei einem Kunststück"
					formats={['avif', 'webp']}
					fallbackFormat="webp"
					widths={[400, 800, 1200]}
					sizes="(min-width: 960px) 300px, 45vw"
				/>
			</figure>
			<figure class="about-accent">
				<Picture
					src={aboutAccent}
					alt="Reinhard Hütter zeigt eine Karte mit rotem Kreis"
					formats={['avif', 'webp']}
					fallbackFormat="webp"
					widths={[400, 800]}
					sizes="(min-width: 960px) 300px, 45vw"
				/>
			</figure>
		</div>
	</div>
</section>

<style>
	.about {
		display: grid;
		gap: var(--space-6);
	}

	.about-copy {
		display: grid;
		gap: var(--space-3);
	}

	.about-text {
		max-width: 38rem;
	}

	.about-text p {
		margin: 0 0 1.25rem;
	}

	.about-lead {
		font-family: var(--font-display);
		font-size: var(--text-lead);
		line-height: 1.45;
		color: var(--color-accent);
	}

	.signature {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--color-accent);
	}

	.about-stage {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2);
		align-items: start;
		max-width: 28rem;
	}

	.about-portrait,
	.about-accent {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.about-portrait :global(img),
	.about-accent :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-portrait {
		aspect-ratio: 3 / 4;
	}

	.about-accent {
		aspect-ratio: 3 / 4;
	}

	@media (min-width: 960px) {
		.about {
			grid-template-columns: 1.15fr 0.95fr;
			gap: var(--space-8);
			align-items: center;
		}

		.about-stage {
			max-width: none;
			justify-self: end;
		}
	}
</style>
