---
import { Picture } from 'astro:assets';
import magicianConcentrating from '../images/magician-concentrating.webp';
import magicianSmilingStanding from '../images/magician-smiling-standing.webp';

// Uncropped photos at their own aspect ratio, sharing one row height
const photos = [
	{ src: magicianConcentrating, alt: 'Reinhard Hütter konzentriert bei einem Kunststück' },
	{ src: magicianSmilingStanding, alt: 'Reinhard Hütter lächelnd am Stehtisch' },
];
---

<section class="section" id="ueber-mich">
	<div class="section-inner about">
		<div class="about-copy">
			<h2 class="section-title">Hinter dem Vorhang</h2>

			<div class="about-text">
				<p class="about-lead">
					Seien Sie gegrüßt! Ich bin Reinhard Hütter – Zauberkünstler, Entertainer und
					leidenschaftlicher Geschichtenerzähler.
				</p>
				<p>
					Seit 10 Jahren verbinde ich Magie mit Schauspiel: Jede Szene ist durchdacht, jeder Moment
					hat Timing – und trotzdem bleibt Platz für das Unerwartete. Das Ergebnis ist Unterhaltung,
					die erstaunt und zum Lachen bringt.
				</p>
				<p>
					Am liebsten bin ich ganz nah dran: Close-up-Magie direkt vor Ihren Augen, Table Hopping
					von Tisch zu Tisch oder eine Show im Salonstil für kleinere und mittlere Gesellschaften.
				</p>
				<p class="signature">Reinhard Hütter</p>
			</div>
		</div>

		<div class="about-stage">
			{
				photos.map(({ src, alt }) => (
					<figure class="about-photo" style={`--ar: ${src.width / src.height};`}>
						<Picture
							src={src}
							alt={alt}
							formats={['avif', 'webp']}
							fallbackFormat="webp"
							widths={[400, 800, 1067]}
							sizes="(min-width: 960px) 300px, 45vw"
						/>
					</figure>
				))
			}
		</div>
	</div>
</section>

<style>
	.about {
		display: grid;
		gap: var(--space-6);
	}

	.about-copy {
		display: grid;
		gap: var(--space-3);
	}

	.about-text {
		max-width: 38rem;
	}

	.about-text p {
		margin: 0 0 1.25rem;
	}

	.about-lead {
		font-family: var(--font-display);
		font-size: var(--text-lead);
		line-height: 1.45;
		color: var(--color-accent);
	}

	.signature {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--color-accent);
	}

	.about-stage {
		display: flex;
		gap: var(--space-2);
		align-items: flex-start;
		max-width: 28rem;
	}

	.about-photo {
		flex: var(--ar) 1 0;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
		aspect-ratio: var(--ar);
	}

	.about-photo :global(picture),
	.about-photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (min-width: 960px) {
		.about {
			grid-template-columns: 1.15fr 0.95fr;
			gap: var(--space-8);
			align-items: center;
		}

		.about-stage {
			max-width: none;
			justify-self: end;
		}
	}
</style>
