---
import { Picture } from 'astro:assets';
// Cut-out portrait with a transparent background, so the page colour shows through exactly (no masks or glows)
import heroPortrait from '../images/hero-portrait.webp';
import { showreel, videoUrl, videoEmbed } from '../data/media';
import FloatingCards from './FloatingCards.astro';
import BurningCard from './effects/BurningCard.astro';

const points = ['Über 10 Jahre Erfahrung', 'Tischzauberei & Salon-Show', 'Verblüffend und mit Humor'];
---

<section class="hero" id="hero" data-hero>
	<div class="hero-inner container">
		<div class="hero-photo">
			<!-- Static stage light behind the figure: light cone from above, body glow, pool on the floor -->
			<div class="stage-light" aria-hidden="true">
				<span class="stage-glow"></span>
				<span class="stage-cone"></span>
				<span class="stage-pool"></span>
			</div>
			<FloatingCards />
			<BurningCard />

			<Picture
				class="portrait"
				src={heroPortrait}
				alt="Reinhard Hütter im dunklen Anzug mit Zauberstab und aufgefächerten Spielkarten"
				formats={['avif', 'webp']}
				fallbackFormat="webp"
				widths={[400, 800, 1254]}
				sizes="(min-width: 960px) 540px, 100vw"
				loading="eager"
				fetchpriority="high"
			/>

			{
				showreel && (
					<a
						class="showreel"
						href={videoUrl(showreel)}
						data-effect="video-lightbox"
						data-video-type={showreel.type}
						data-video-embed={videoEmbed(showreel)}
						data-video-title="Showreel Reinhard Hütter"
					>
						<span class="showreel-button" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d="M8 5.5v13l11-6.5z" />
							</svg>
						</span>
						<span class="showreel-label">Showreel</span>
					</a>
				)
			}
		</div>

		<div class="hero-content">
			<!-- The name is only visible in the logo; it stays in the heading for search engines -->
			<h1 class="hero-title">
				<span class="visually-hidden">Reinhard Hütter – </span>
				<span class="line">Moderne <span class="shine">Zauberkunst</span></span>
				<span class="line">für Ihr Event</span>
			</h1>
			<ul class="hero-points">
				{points.map((point) => <li>{point}</li>)}
			</ul>
			<a class="button hero-button" href="#kontakt">Show anfragen</a>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Photo is limited on tablets so it does not grow endlessly */
		--photo-width: min(100vw, 560px);
		/* Room for the fixed header, plus some air so the head is never cut off */
		padding-top: calc(var(--header-height) + var(--space-4));
		background: var(--bg);
		/* Decorative light and cards must never cause horizontal scrolling */
		overflow-x: clip;
	}

	.hero-photo {
		position: relative;
		width: var(--photo-width);
		margin-inline: auto;
	}

	/* Phones: photo runs edge to edge, ignoring the side gutter */
	@media (max-width: 559px) {
		.hero-photo {
			margin-inline: calc(var(--gutter) * -1);
		}
	}

	.hero-photo :global(.portrait) {
		position: relative;
		width: 100%;
		object-fit: contain;
		object-position: top;
	}

	/* ---- Stage light (static, decorative) ---- */
	.stage-light {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.stage-light span {
		position: absolute;
	}

	/* Wide, very soft lightening around the body */
	.stage-glow {
		inset: 15% 10% 5%;
		background: radial-gradient(closest-side, var(--color-stage-glow), transparent);
	}

	/* Soft light cone falling in diagonally from the top.
	   Blur sits on the outer box so it also softens the cut-out cone edges. */
	.stage-cone {
		top: -25%;
		left: 28%;
		width: 50%;
		height: 120%;
		filter: blur(28px);
		transform: rotate(-14deg);
		transform-origin: 50% 0;
	}

	.stage-cone::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, var(--color-stage-cone), transparent 85%);
		clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%);
	}

	/* Flat elliptic pool of light on the floor under the figure */
	.stage-pool {
		left: 18%;
		right: 18%;
		bottom: 1%;
		height: 12%;
		background: radial-gradient(closest-side, var(--color-stage-pool), transparent);
	}

	/* Burning card: left of the figure, in the gap between text and person, at body height.
	   Only left/top/width are set here; the card must not get a transform or z-index
	   (its flames rely on mix-blend-mode against the hero background). */
	.hero-photo :global(.burning-card) {
		--burning-card-width: 26%;
		left: 1%;
		top: 34%;
	}

	@media (min-width: 960px) {
		.hero-photo :global(.burning-card) {
			--burning-card-width: 32%;
			left: -12%;
			top: 40%;
		}
	}

	/* ---- Silver shine: one pass over "Zauberkunst" after loading ---- */
	@media (prefers-reduced-motion: no-preference) {
		.shine {
			background: linear-gradient(
					105deg,
					var(--color-text) 40%,
					var(--color-shine) 50%,
					var(--color-text) 60%
				)
				100% 0 / 300% 100% no-repeat;
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			animation: shine var(--duration-shine) ease-in-out 0.5s 1 both;
		}
	}

	@keyframes shine {
		from {
			background-position: 100% 0;
		}

		to {
			background-position: 0 0;
		}
	}

	/* Showreel play button, level with the fanned cards */
	.showreel {
		position: absolute;
		z-index: 2;
		top: 30%;
		left: 8%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		text-decoration: none;
	}

	.showreel-button {
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 3.5rem;
		border: 1px solid var(--color-accent);
		border-radius: 50%;
		background: var(--color-button-glass);
		color: var(--color-accent);
		transition:
			background-color var(--duration-fast),
			color var(--duration-fast);
	}

	.showreel-button svg {
		width: 1.25rem;
		height: 1.25rem;
		margin-left: 0.15rem;
		fill: currentColor;
	}

	.showreel:hover .showreel-button,
	.showreel:focus-visible .showreel-button {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.showreel-label {
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	/* Phones: text block overlaps the lower part of the photo, where the legs fade out */
	.hero-content {
		position: relative;
		margin-top: calc(var(--photo-width) * -0.3);
		padding-bottom: var(--section-space);
	}

	.hero-title {
		margin: 0 0 var(--space-5);
		font-size: var(--text-display);
		line-height: var(--lh-display);
	}

	.hero-title .line {
		display: block;
	}

	.hero-points {
		display: grid;
		gap: var(--space-2);
		margin: 0 0 var(--space-7);
		padding: 0;
		list-style: none;
		font-family: var(--font-display);
		font-size: var(--text-points);
		font-weight: var(--weight-display-light);
		line-height: var(--leading-tight);
		color: var(--color-accent);
	}

	.hero-points li {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}

	/* Small diamond in front of every line */
	.hero-points li::before {
		content: '';
		flex: none;
		width: 0.3em;
		height: 0.3em;
		background: currentColor;
		transform: rotate(45deg);
	}

	/* Full-width button on phones */
	.hero-button {
		width: 100%;
	}

	@media (min-width: 720px) {
		.hero-button {
			width: auto;
		}
	}

	/* Desktop: text vertically centred beside the figure, left edge in line with the logo */
	@media (min-width: 960px) {
		.hero {
			--photo-width: 540px;
		}

		.hero-inner {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: var(--space-6);
		}

		.hero-photo {
			order: 2;
			width: 100%;
			max-width: var(--photo-width);
			margin: 0;
			justify-self: end;
		}

		.hero-content {
			order: 1;
			margin: 0;
			padding-bottom: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.showreel-button {
			transition: none;
		}
	}
</style>
