---
import { Picture } from 'astro:assets';
// Cut-out portrait with a transparent background, so the page colour shows through exactly (no masks or glows)
import heroPortrait from '../images/hero-portrait.webp';
---

<section class="hero" id="hero" data-hero>
	<div class="hero-inner">
		<div class="hero-photo">
			<Picture
				class="portrait"
				src={heroPortrait}
				alt="Reinhard Hütter im dunklen Anzug mit Zauberstab und aufgefächerten Spielkarten"
				formats={['avif', 'webp']}
				fallbackFormat="webp"
				widths={[400, 800, 1254]}
				sizes="(min-width: 960px) 540px, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<div class="hero-content">
			<p class="eyebrow">Zauberkünstler &amp; Entertainer</p>
			<!-- The name is only visible in the logo; it stays in the heading for search engines -->
			<h1 class="claim">
				<span class="visually-hidden">Reinhard Hütter – </span>Magie auf dem silbernen Tablett
			</h1>
			<a class="button" href="#kontakt">Show anfragen</a>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Photo is limited on tablets so it does not grow endlessly */
		--photo-width: min(100vw, 560px);
		/* Room for the fixed header, plus some air so the head is never cut off */
		padding-top: calc(var(--header-height) + var(--space-4));
		background: var(--color-bg);
	}

	.hero-photo {
		position: relative;
		width: var(--photo-width);
		margin: 0 auto;
	}

	.hero-photo :global(.portrait) {
		width: 100%;
		object-fit: contain;
		object-position: top;
	}

	/* Lower part of the photo runs into the page colour, so photo and text read as one unit */
	.hero-photo::after {
		content: '';
		position: absolute;
		inset: 45% 0 0;
		background: linear-gradient(to bottom, transparent, var(--color-bg) 85%);
		pointer-events: none;
	}

	/* Mobile: text block overlaps the faded lower part of the photo */
	.hero-content {
		position: relative;
		max-width: var(--photo-width);
		margin: calc(var(--photo-width) * -0.3) auto 0;
		padding: 0 var(--gutter) var(--section-space);
	}

	.hero-content .eyebrow {
		margin-bottom: var(--space-2);
	}

	.claim {
		margin: 0 0 var(--space-7);
		font-size: var(--text-display);
		font-style: italic;
		font-weight: var(--weight-display-light);
		line-height: var(--leading-tight);
		color: var(--color-accent);
	}

	/* Desktop: text vertically centred beside the figure, left edge in line with the logo */
	@media (min-width: 960px) {
		.hero-inner {
			display: grid;
			grid-template-columns: 1fr 540px;
			align-items: center;
			max-width: calc(var(--content-width) + 2 * var(--gutter));
			margin: 0 auto;
			padding: 0 var(--gutter);
		}

		.hero {
			--photo-width: 540px;
		}

		.hero-photo {
			order: 2;
		}

		.hero-photo::after {
			inset: 70% 0 0;
		}

		.hero-content {
			order: 1;
			max-width: none;
			margin: 0;
			padding: 0;
		}
	}
</style>
