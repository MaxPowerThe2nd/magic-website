---
import { Picture } from 'astro:assets';
// Cut-out portrait with a transparent background, so the page colour shows through exactly (no masks or glows)
import heroPortrait from '../images/hero-portrait.webp';
---

<section class="hero" id="hero" data-hero>
	<div class="hero-inner">
		<div class="hero-photo">
			<Picture
				class="portrait"
				src={heroPortrait}
				alt="Reinhard Hütter im dunklen Anzug mit Zauberstab und aufgefächerten Spielkarten"
				formats={['avif', 'webp']}
				fallbackFormat="webp"
				widths={[400, 800, 1254]}
				sizes="(min-width: 960px) 540px, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<div class="hero-content">
			<p class="eyebrow">Zauberkünstler &amp; Entertainer</p>
			<h1 class="stage-name">Reinhard Hütter</h1>
			<p class="claim">Magie auf dem silbernen Tablett</p>
			<a class="button" href="#kontakt">Show anfragen</a>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Room for the fixed header */
		padding-top: var(--header-height);
		background: var(--color-bg);
	}

	.hero-photo :global(.portrait) {
		width: 100%;
	}

	/* Text sits on the plain lower part of the photo, where the legs fade out */
	.hero-content {
		position: relative;
		margin-top: calc(var(--space-8) * -1.5);
		padding: 0 var(--gutter) var(--section-space);
	}

	.stage-name {
		margin: 0 0 var(--space-3);
		font-size: var(--text-h2);
	}

	.claim {
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-lead);
		font-style: italic;
		line-height: var(--leading-tight);
		color: var(--color-accent);
	}

	/* Side by side on large screens: text left, portrait right */
	@media (min-width: 960px) {
		.hero-inner {
			display: grid;
			grid-template-columns: 1fr 540px;
			align-items: end;
			max-width: calc(var(--content-width) + 2 * var(--gutter));
			margin: 0 auto;
			padding: var(--space-6) var(--gutter) 0;
		}

		.hero-photo {
			order: 2;
		}

		.hero-content {
			order: 1;
			margin: 0;
			padding: 0 0 var(--section-space);
		}
	}
</style>
