---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import firmeneventsPhoto from '../images/table-hopping-audience.webp';
import familienfeierPhoto from '../images/rope-girl-laughing.webp';

const occasions: {
	label: string;
	kicker: string;
	image: ImageMetadata;
	alt: string;
}[] = [
	{
		label: 'Firmenevents',
		kicker: 'Messen · Empfänge · Galas',
		image: firmeneventsPhoto,
		alt: 'Reinhard Hütter beim Table Hopping, Gäste schauen gespannt zu',
	},
	{
		label: 'Privatfeiern',
		kicker: 'Familienfeiern · Geburtstage',
		image: familienfeierPhoto,
		alt: 'Ein Mädchen lacht bei einer Seilnummer von Reinhard Hütter, im Hintergrund staunende Gäste',
	},
];
---

<section class="section occasions" id="shows" aria-label="Anlässe">
	<div class="section-inner">
		<p class="occasions-text">
			<span class="occasions-list">
				Firmenevents<span class="visually-hidden">,</span><span class="dot" aria-hidden="true"> · </span>Privatfeiern<span
					class="visually-hidden">,</span
				><span class="dot" aria-hidden="true"> · </span>Hochzeiten
			</span>{' '}<span class="occasions-punch">
				<span class="punch-part">… oder Scheidungen.</span>{' '}<span class="punch-part"
					>Ein wenig Magie schadet nie.</span
				>
			</span>
		</p>

		<ul class="occasion-stage">
			{
				occasions.map(({ label, kicker, image, alt }) => (
					<li class="occasion-panel">
						<div class="occasion-photos">
							<figure class="occasion-hero" style={`--ar: ${image.width / image.height};`}>
								<Picture
									src={image}
									alt={alt}
									formats={['avif', 'webp']}
									fallbackFormat="webp"
									widths={[400, 800, 1200]}
									sizes="(min-width: 720px) 46vw, 92vw"
								/>
							</figure>
						</div>
						<div class="occasion-caption">
							<p class="occasion-label">{label}</p>
							<p class="occasion-kicker">{kicker}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.occasions-text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-3);
		margin: 0;
		text-align: center;
	}

	.occasions-list {
		text-wrap: balance;
		font-family: var(--font-body);
		font-size: var(--text-interlude-small);
		font-weight: 500;
		letter-spacing: var(--tracking-interlude);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.dot {
		white-space: pre;
	}

	.occasions-punch {
		font-family: var(--font-display);
		font-size: var(--text-interlude);
		font-weight: var(--weight-display-light);
		line-height: var(--leading-tight);
		color: var(--color-text);
	}

	.punch-part {
		display: block;
	}

	.occasion-stage {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.occasion-panel {
		margin: 0;
		display: grid;
		gap: var(--space-3);
	}

	.occasion-photos {
		position: relative;
	}

	.occasion-hero {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
		aspect-ratio: var(--ar);
	}

	.occasion-hero :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.occasion-caption {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
	}

	.occasion-label {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.occasion-kicker {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--color-text-faint);
	}

	@media (min-width: 720px) {
		.punch-part {
			display: inline;
		}

		.occasions-list {
			display: flex;
			align-items: center;
			gap: var(--space-4);
		}

		.occasions-list::before,
		.occasions-list::after {
			content: '';
			width: 60px;
			height: 1px;
			background: var(--color-border-strong);
		}

		.occasion-stage {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-3);
		}

	}
</style>
