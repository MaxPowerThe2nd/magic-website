---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bühnenname">
	<section class="hero">
		<!-- Placeholder until the final hero photo is chosen -->
		<div class="hero-photo" role="img" aria-label="Platzhalter für das Hero-Foto">
			<span class="hero-photo-label">Foto-Platzhalter</span>
		</div>

		<div class="hero-content">
			<h1 class="stage-name">Bühnenname</h1>
			<p class="tagline">Hier steht der Slogan in einer Zeile.</p>
			<a class="button" href="#kontakt">Show anfragen</a>
		</div>
	</section>
</Layout>

<style>
	/* Full-screen hero: photo fills the screen, text sits on the lower part */
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 100svh;
		overflow: hidden;
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(ellipse 80% 55% at 50% 35%, #1d3a6e 0%, transparent 70%),
			var(--color-surface);
	}

	.hero-photo-label {
		margin-bottom: 30svh;
		padding: 0.5rem 1rem;
		border: 1px dashed rgb(244 236 216 / 0.4);
		border-radius: 4px;
		font-size: var(--text-small);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: rgb(244 236 216 / 0.6);
	}

	/* Dark fade at the bottom keeps the text readable on any photo */
	.hero::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 65%;
		background: linear-gradient(to top, var(--color-midnight) 15%, transparent);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		padding: 0 1.25rem 3rem;
	}

	.stage-name {
		margin: 0 0 0.75rem;
		font-size: var(--text-display);
		color: var(--color-gold);
	}

	.tagline {
		margin: 0 0 2rem;
		font-size: var(--text-lead);
		line-height: 1.4;
	}

	@media (min-width: 720px) {
		.hero-content {
			width: 100%;
			max-width: 1120px;
			margin: 0 auto;
			padding: 0 2.5rem 5rem;
		}

		.tagline {
			margin-bottom: 2.5rem;
		}
	}
</style>
